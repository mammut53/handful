{
  "schemaVersion": 1,
  "id": "${mod_id}",
  "version": "${version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_author}"
  ],
  "contact": {
    "homepage": "${mod_homepage}",
    "sources": "${mod_sources}"
  },
  "license": "${mod_license}",
  "icon": "assets/handful/icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "io.github.mammut53.handful.Handful"
    ]
  },
  "mixins": [
    "handful.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16",
    "minecraft": ">=1.21.4",
    "java": ">=21"
  },
  "accessWidener" : "handful.accesswidener",
  "custom": {
    "loom:injected_interfaces": {
      "net/minecraft/class_10426": ["io/github/mammut53/handful/client/renderer/entity/state/ArmedEntityRenderStateItemStacks"]
    }
  }
}